---
/**
 * Logo — brand mark + wordmark. The mark is an inline SVG (no external assets).
 */
import { SITE } from '../config/site.mjs';

interface Props {
  size?: 'sm' | 'md';
  inverted?: boolean;
}
const { size = 'md', inverted = false } = Astro.props;
const mark = 36;
const word = size === 'md' ? 'text-[1.35rem]' : 'text-[1.1rem]';
const sub = size === 'md' ? '' : 'hidden sm:block';
const ink = inverted ? 'text-paper' : 'text-ink';
const faint = inverted ? 'text-paper/55' : 'text-ink-faint';
---
<a href="/" class="inline-flex items-center gap-2.5 group" aria-label={`${SITE.name} — home`}>
  <svg width={mark} height={mark} viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
    <rect width="64" height="64" rx="12" fill={inverted ? '#F7F6F2' : '#15181D'} />
    <path d="M14 20h36M14 32h28M14 44h32" stroke={inverted ? '#15181D' : '#F7F6F2'} stroke-width="5" stroke-linecap="round" />
    <circle cx="50" cy="20" r="4.5" fill="#5479E0" />
  </svg>
  <span class={`font-display font-bold leading-none tracking-tight ${ink} ${word}`}>
    {SITE.name}
    <span class={`mt-1 block text-[0.68rem] font-medium uppercase tracking-[0.18em] ${faint} ${sub}`}>
      {SITE.tagline.split(' ')[0]} · AI skills
    </span>
  </span>
</a>